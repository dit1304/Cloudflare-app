{
  "name": "temp-email-bot-cf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 5000 --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create temp-email-db",
    "db:migrate": "wrangler d1 execute temp-email-db --file=./src/db/schema.sql",
    "db:migrate:prod": "wrangler d1 execute temp-email-db --file=./src/db/schema.sql --remote",
    "db:migrate:broadcast": "wrangler d1 execute temp-email-db --file=./src/db/migrations/add_broadcast_queue.sql --remote",
    "db:migrate:apikeys": "wrangler d1 execute temp-email-db --file=./src/db/migrations/add_api_keys.sql --remote"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "otpauth": "^9.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/qrcode-generator": "^0.0.16",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
